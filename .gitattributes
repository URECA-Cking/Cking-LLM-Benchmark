# CSV는 무결성을 SHA-256 바이트 해시로 검사한다(src/data.py verify_data_hashes).
# Windows에서 Git이 자동으로 LF->CRLF 변환을 하면 내용은 그대로인데 해시가 달라져
# 검사가 실패한다 (2026-09-28 리뷰로 재현). 항상 LF로 고정한다.
data/*.csv text eol=lf
# e2_judgments.json도 같은 이유로 해시를 검사한다(src/paired_diff.py)
data/*.json text eol=lf
# 계약 fixture는 원본 CRLF/CR과 canonical JSON의 마지막 개행 부재까지 검증한다.
tests/fixtures/taxonomy/* -text
# 원본 CSV의 의도적인 CR·탭·양끝 공백은 텍스트 공백 오류 검사에서 제외한다.
tests/fixtures/taxonomy/input.csv -diff
# Python·Java 공용 개인화 fixture는 플랫폼에 상관없이 UTF-8/LF로 유지한다.
fixtures/*.json text eol=lf
