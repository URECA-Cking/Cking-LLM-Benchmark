# OpenAI 기반 임베딩·태깅·판정·데이터 생성에 사용한다. 서비스 추천에서는 M4 태그 캐시 미스 때 필요하다
OPENAI_API_KEY=
# 임베딩 캐시에 없는 소개를 처리하거나 API bge-m3 비교·파라미터 재선택을 실행할 때 필요하다
DEEPINFRA_API_KEY=
# 기존 관리자 도구 호환용 JWT다. 추천 배치 CLI apply는 전용 API Key를 요구한다.
CKING_ADMIN_ACCESS_TOKEN=
# 유사 추천·관심 분야·일일 통합 batch apply에 필수인 추천 적재 전용 키다.
CKING_RECOMMENDATION_API_KEY=
